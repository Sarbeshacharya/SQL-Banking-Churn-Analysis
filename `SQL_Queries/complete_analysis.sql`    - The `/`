-- Customer Lifetime Value (CLV):
-- CLV by segment
-- Which segments generate most lifetime value?
-- CLV of churned customers (opportunity cost)

WITH customer_clv AS (
    SELECT 
        *,
        -- Annual revenue per customer
        (balance * 0.02) + (estimatedsalary * 0.005) as annual_revenue,
        -- Estimated CLV (10-year horizon)
        ((balance * 0.02) + (estimatedsalary * 0.005)) * 10 as estimated_clv,
        -- Segment classification
        CASE 
            WHEN balance > 150000 THEN 'VIP'
            WHEN balance BETWEEN 100000 AND 150000 THEN 'Premium'
            WHEN balance BETWEEN 50000 AND 100000 THEN 'Standard'
            ELSE 'Basic'
        END as value_segment
    FROM churn_modelling
)
-- Overall CLV Summary
SELECT 
    'Overall' as segment,
    COUNT(*) as customers,
    ROUND(AVG(estimated_clv), 2) as avg_clv,
    ROUND(SUM(estimated_clv), 2) as total_clv,
    ROUND(SUM(CASE WHEN exited=1 THEN estimated_clv ELSE 0 END), 2) as clv_lost_to_churn,
    ROUND(SUM(CASE WHEN exited=1 THEN estimated_clv ELSE 0 END) / SUM(estimated_clv) * 100, 2) as pct_clv_at_risk
FROM customer_clv

UNION ALL

-- CLV by Value Segment
SELECT 
    value_segment,
    COUNT(*) as customers,
    ROUND(AVG(estimated_clv), 2) as avg_clv,
    ROUND(SUM(estimated_clv), 2) as total_clv,
    ROUND(SUM(CASE WHEN exited=1 THEN estimated_clv ELSE 0 END), 2) as clv_lost_to_churn,
    ROUND(AVG(exited) * 100, 2) as churn_rate
FROM customer_clv
GROUP BY value_segment
ORDER BY total_clv DESC;

